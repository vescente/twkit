# twkit settings. Copy to ~/.twkit/.env and chmod 600; never commit the filled copy.
# The process environment overrides this file; this file overrides ~/.twkit/config.toml.

# ClickHouse: data checks, dry runs, extracts
TWKIT_CH_HOST=clickhouse.example.com
TWKIT_CH_PORT=8443
TWKIT_CH_USER=reader
TWKIT_CH_PASSWORD=
TWKIT_CH_DB=default
TWKIT_CH_CERT=~/.twkit/clickhouse.crt

# Workbook database: the connection the workbooks use (Tableau sign-in)
TWKIT_DB_HOST=db.example.com
TWKIT_DB_PORT=3306
TWKIT_DB_USER=reader
TWKIT_DB_NAME=
TWKIT_DB_PASSWORD=
